<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand navy base so the splash never flashes white -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B1A3D" />
        </shape>
    </item>
    <!-- Full-bleed branded splash artwork (density + orientation specific) -->
    <item>
        <bitmap
            android:src="@drawable/splash"
            android:gravity="fill" />
    </item>
</layer-list>
